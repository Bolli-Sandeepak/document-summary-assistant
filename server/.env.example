# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Gemini API Key (Required for AI summarization)
# Get your key from: https://aistudio.google.com/apikey
# If left blank, the system uses a basic local text summarizer
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URI (Optional: if blank, document history storage is disabled)
MONGODB_URI=mongodb://localhost:27017/docsummary

# Allowed Frontend Client Origin for CORS (comma separated for multiple origins)
# In production, set this to your Vercel frontend URL
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
